{
  "name": "zulip",
  "version": "5.14.3",
  "private": true,
  "description": "Zulip Desktop App",
  "license": "Apache-2.0",
  "repository": "github:zulip/zulip-desktop",
  "bugs": "https://github.com/zulip/zulip-desktop/issues",
  "author": "Kandra Labs, Inc. <support@zulip.com>",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975",
  "scripts": {
    "dev": "install-electron && electron-vite dev",
    "preview": "install-electron && electron-vite preview",
    "build": "install-electron && electron-vite build",
    "watch-ts": "tsc -w",
    "postinstall": "electron-builder install-app-deps",
    "lint-css": "stylelint \"app/**/*.css\"",
    "lint-html": "htmlhint \"app/**/*.html\"",
    "lint-js": "xo .",
    "prettier": "prettier --check --log-level=warn .",
    "test": "tsc && node --run lint-html && node --run lint-css && node --run lint-js && node --run prettier",
    "test-e2e": "node --run build && playwright test",
    "pack": "node --run build && electron-builder --dir",
    "dist": "node --run build && electron-builder",
    "mas": "node --run build && electron-builder --mac=mas"
  },
  "dependencies": {
    "gatemaker": "^1.0.0"
  },
  "devDependencies": {
    "@electron/remote": "^2.0.8",
    "@playwright/test": "^1.65.1",
    "@sentry/core": "^11.8.0",
    "@sentry/electron": "^8.3.0",
    "@types/auto-launch": "^5.0.2",
    "@types/backoff": "^2.5.2",
    "@types/i18n": "^0.13.1",
    "@types/minimalistic-assert": "^1.0.3",
    "@types/node": "^24.13.2",
    "@types/semver": "^7.5.8",
    "@types/yaireo__tagify": "^4.3.2",
    "@typescript/native": "npm:typescript@latest",
    "@yaireo/tagify": "^4.5.0",
    "adm-zip": "^0.6.1",
    "auto-launch": "^5.0.5",
    "backoff": "^2.5.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-log": "^5.0.3",
    "electron-updater": "^6.3.4",
    "electron-vite": "^6.0.0",
    "electron-window-state": "^5.0.3",
    "escape-goat": "^4.0.0",
    "htmlhint": "^1.1.2",
    "i18n": "^0.15.1",
    "i18next-cli": "^1.2.1",
    "minimalistic-assert": "^1.0.1",
    "node-json-db": "^1.3.0",
    "prettier": "^3.0.3",
    "semver": "^7.3.5",
    "stylelint": "^18.1.0",
    "stylelint-config-standard": "^41.1.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.1.0",
    "xo": "^5.0.0",
    "zod": "^4.1.5"
  },
  "productName": "Zulip",
  "desktopName": "org.zulip.Zulip.desktop",
  "copyright": "Kandra Labs, Inc.",
  "build": {
    "appId": "org.zulip.zulip-electron",
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "files": [
      "out/**/*"
    ],
    "copyright": "©2020 Kandra Labs, Inc.",
    "toolsets": {
      "appimage": "1.0.3"
    },
    "publish": {
      "provider": "github",
      "releaseType": "draft"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon-macos.png",
      "target": [
        {
          "target": "default",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "pkg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "category": "Chat;GNOME;GTK;Network;InstantMessaging",
      "icon": "build/zulip.png",
      "description": "Zulip Desktop Client for Linux",
      "target": [
        "deb",
        "tar.xz",
        "AppImage",
        "snap"
      ],
      "maintainer": "Akash Nimare <akash@zulip.com>",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "syncDesktopName": true
    },
    "deb": {
      "packageCategory": "net",
      "synopsis": "Zulip Desktop App",
      "fpm": [
        "--before-install=./packaging/deb-before-install.sh",
        "./packaging/deb-apt.sources=/etc/apt/sources.list.d/zulip-desktop.sources",
        "./packaging/deb-apt.asc=/usr/share/keyrings/zulip-desktop.asc",
        "./packaging/deb-release-upgrades.cfg=/etc/update-manager/release-upgrades.d/zulip-desktop.cfg"
      ]
    },
    "snapcraft": {
      "base": "core24",
      "publish": {
        "provider": "github",
        "releaseType": "draft"
      },
      "core24": {
        "extensions": [
          "gnome"
        ],
        "plugs": [
          "default",
          "browser-support"
        ]
      }
    },
    "dmg": {
      "background": "build/dmg-background.tiff",
      "icon": "build/dmg-icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis-web",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "azureSignOptions": {
        "endpoint": "https://eus.codesigning.azure.net/",
        "codeSigningAccountName": "kandralabs",
        "certificateProfileName": "kandralabs",
        "publisherName": "Kandra Labs, Inc.",
        "timestampRfc3161": "http://timestamp.acs.microsoft.com",
        "timestampDigest": "SHA256"
      }
    },
    "msi": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "oneClick": false,
      "perMachine": false
    },
    "nsisWeb": {
      "artifactName": "${productName}-Web-Setup-${version}.${ext}"
    }
  },
  "prettier": {
    "bracketSpacing": false,
    "singleQuote": false,
    "trailingComma": "all"
  }
}
